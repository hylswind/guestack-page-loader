# Copy to .env and fill in. Read by scripts/*.mjs (and by wrangler).

# Cloudflare Pages project the loader is deployed to.
PAGES_PROJECT=loader

# R2 bucket used only by scripts/seed-dev.mjs (dev bucket, never production).
R2_BUCKET=loader-pages

# API token with Pages edit (and R2 edit for seeding) permissions.
# Not needed if you are logged in with `npx wrangler login`.
CLOUDFLARE_API_TOKEN=
