# Copy to .env and fill in. Read by scripts/*.mjs (and by the aws and wrangler CLIs).

# S3 bucket that holds the loader's index.html (scripts/deploy-loader.mjs).
LOADER_BUCKET=
# Optional named AWS profile; any standard AWS credentials work.
AWS_PROFILE=
# How long Cloudflare keeps the loader at the edge, in seconds (default 300).
# Use 31536000 (one year) in production and purge the loader host after each deploy.
LOADER_EDGE_TTL=300

# R2 bucket seeded with the test fixtures by scripts/seed-dev.mjs (dev bucket, never production).
R2_BUCKET=guestack-cdn
# Cloudflare account that owns R2_BUCKET.
CLOUDFLARE_ACCOUNT_ID=
# API token with R2 edit permission on that account.
# Not needed if you are logged in with `npx wrangler login`.
CLOUDFLARE_API_TOKEN=
